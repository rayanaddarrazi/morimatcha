{
  "name": "morimatcha",
  "version": "1.0.0",
  "description": "WordPress theme voor Mori Matcha, gebouwd op de KJ Boilerplate",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "NODE_ENV=production postcss assets/css/input.css -o assets/css/style.css",
    "build:js": "node scripts/build-pagebuilder-js.js && node scripts/build-blik3d.js",
    "dev": "npm run dev:css",
    "dev:css": "postcss assets/css/input.css -o assets/css/style.css --watch",
    "lint": "npm run lint:js && npm run lint:php",
    "lint:js": "eslint . --ignore-pattern '*.min.js' --ignore-pattern 'assets/js/blik3d.js'",
    "lint:js:fix": "eslint . --fix --ignore-pattern '*.min.js'",
    "lint:php": "find . -name '*.php' -not -path './node_modules/*' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l"
  },
  "author": "Rayan",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "autoprefixer": "^10.4.16",
    "cssnano": "^8.0.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "globals": "^17.2.0",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.0",
    "tailwindcss": "^3.4.0",
    "three": "^0.186.1"
  }
}
